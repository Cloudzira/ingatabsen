{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ingatabsen",
  "main": "src/index.js",
  "compatibility_date": "2026-10-31",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ingatabsen-db",
      "database_id": "a3f586f5-7bb1-41a6-810f-3ec7bd841522",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
